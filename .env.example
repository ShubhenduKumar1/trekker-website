# Public WhatsApp number, international digits only (country code + number, no +, spaces or dashes).
# Example format for an Indian number: 91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Production site URL, used for canonical URLs, Open Graph and the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Payload CMS -----------------------------------------------------------

# Postgres connection string (e.g. from Neon, Vercel Postgres, or local Postgres).
DATABASE_URI=postgresql://user:password@localhost:5432/trekker

# Random long string used to sign Payload's auth tokens. Generate with:
#   npx payload secret
PAYLOAD_SECRET=

# Vercel Blob token for storing uploaded images in production. Without it,
# uploads fall back to local disk (dev only — doesn't persist on Vercel).
BLOB_READ_WRITE_TOKEN=

# Gates the draft-preview route (/next/preview) so only /admin's Live Preview
# and Preview button can enable Next.js Draft Mode. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PREVIEW_SECRET=
